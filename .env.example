# ---- Frontend (Vite) ----
# Supabase connection (REQUIRED — the app does not run without these).
# Copy this file to `.env` for local dev, or set the same keys in your
# hosting dashboard (Vercel/Netlify/Railway → Environment Variables).
# Values come from: Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# AI endpoints (optional until the Railway backend is deployed — without
# them, offline AI templates / the on-device DanTECH tutor are used).
# NEVER put AI API keys in frontend variables.
VITE_AI_ENDPOINT=https://your-api.example.com/api/ai/generate
VITE_DANTECH_ENDPOINT=https://your-api.example.com/api/dantech/chat

# ---- Server only (Railway Variables — never expose to frontend) ----
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
# ADMIN_TOKEN=long-random-secret
# ALLOWED_ORIGINS=https://yourdomain.com
# SUPABASE_URL=...
# SUPABASE_SERVICE_ROLE_KEY=...
