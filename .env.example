# ---- Frontend (Vite) ----
# Supabase (optional — app runs fully offline on local store without these)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Secure AI backend endpoint (optional — without it, offline AI templates are used).
# Point to YOUR server running server/ai-gateway.example.mjs. NEVER put AI API keys here.
VITE_AI_ENDPOINT=https://your-api.example.com/api/ai/generate

# ---- Server only (never expose to frontend) ----
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
# ADMIN_TOKEN=long-random-secret
# ALLOWED_ORIGINS=https://yourdomain.com
# SUPABASE_URL=...
# SUPABASE_SERVICE_ROLE_KEY=...
