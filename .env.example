# ---- Frontend (Vite) ----
# Supabase connection (REQUIRED — the app does not run without these).
# Copy this file to `.env` for local dev, or set the same keys in your
# hosting dashboard (Vercel/Netlify/Railway → Environment Variables).
# Values come from: Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---- Course catalogue & classroom API (Tech-hub-backend) ----
# The storefront is DATA-DRIVEN: categories come from GET /api/course-categories
# and courses from GET /api/courses (category_id / search / difficulty filters).
# Course outlines come from GET /api/classroom/:idOrSlug/outline and the enrolled
# student's classroom from GET /api/classroom/:idOrSlug.
#
# Leave VITE_API_URL UNSET to call same-origin /api — recommended when the API
# sits behind the same domain, and what the vite dev proxy uses (see
# vite.config.js → server.proxy['/api']). Set it only for a separate API origin.
# VITE_API_URL=https://your-backend.example.com
#
# Local run without a deploy (stand-in server, no Supabase project needed):
#   npm run mock:api     # serves /api/* on :8789, proxied by `npm run dev`

# ---- JAMB CBT exam API (agreed contract) ----
# Served by Tech-hub-backend (branch arena/01a10cb1-tech-hub-backend, commit
# 46025db, src/routes/jamb.routes.js). Paths are RELATIVE TO THE /api BASE, so
# same-origin deploys and the vite dev proxy both work unchanged.
#
# src/lib/jambApi.js hard-codes no route: it only ever calls what is configured
# here. Remove a line and that capability switches off honestly (the page then
# says the exam service is not connected instead of guessing a URL).
#
# The paper response carries `expires_at`, so the countdown is server-owned; the
# UI labels a client clock as a display timer. `questions[].id` IS the attempt
# item id, which is why submit sends `question_id` and autosave `attempt_item_id`.
VITE_EXAM_API_SUBJECTS_PATH=/jamb/subjects
VITE_EXAM_API_ATTEMPTS_PATH=/jamb/attempts
VITE_EXAM_API_SUBMIT_PATH=/jamb/attempts/:attemptId/submit
VITE_EXAM_API_HISTORY_PATH=/jamb/attempts
# Optional: debounced autosave of chosen options. Unset = answers are described
# as saved on this device only (the UI never claims a server save it cannot make).
VITE_EXAM_API_ANSWERS_PATH=/jamb/attempts/:attemptId/answers

# ---- Passkeys / Google Authenticator (Supabase project settings) ----
# No key needed here. Enable in the Supabase dashboard:
#   Authentication → Providers → Passkeys (WebAuthn)   → turn on
#   Authentication → Multi-factor Auth                  → turn on TOTP
# The browser keeps fingerprint / Face ID / device PIN on the device; Supabase
# stores only a credential id and a public key. Never collect biometric data.

# AI endpoints (optional until the Railway backend is deployed — without
# them, offline AI templates / the on-device DanTECH tutor are used).
# NEVER put AI API keys in frontend variables.
# The site adds `Authorization: Bearer <signed-in user's token>` to both calls so
# the gateway can rate-limit per student and check enrolment; the gateway must
# allow this site in ALLOWED_ORIGINS or the browser blocks the request (the site
# then says so and answers on-device). Contract + statuses: server/README.md.
VITE_AI_ENDPOINT=https://your-api.example.com/api/ai/generate
VITE_DANTECH_ENDPOINT=https://your-api.example.com/api/dantech/chat
# Local check without a deploy: `npm run mock:ai`, then
# VITE_DANTECH_ENDPOINT=http://localhost:8788/api/dantech/chat npm run dev

# ---- Server only (Railway Variables — never expose to frontend) ----
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
# ADMIN_TOKEN=long-random-secret
# ALLOWED_ORIGINS=https://yourdomain.com
# CHAT_RATE_PER_MIN=30
# SUPABASE_URL=...                       # verifies the student bearer token
# SUPABASE_SERVICE_ROLE_KEY=...
